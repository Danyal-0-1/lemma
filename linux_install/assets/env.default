# Lemma user configuration. This file is private (mode 0600).
# Provider keys belong only here; never commit this file.
MOCK_LLM=true
ENABLE_HOST_EXECUTION=false

# API-key routes use separately metered provider APIs. Uncomment only the routes you
# need; secrets remain in this mode-0600 file and are passed only to that API call.
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Explicit local/custom routes. Ollama is restricted to loopback; remote custom
# OpenAI-compatible URLs must use HTTPS.
LEMMA_OLLAMA_BASE_URL=http://127.0.0.1:11434
LEMMA_OLLAMA_MODELS=
LEMMA_CUSTOM_OPENAI_BASE_URL=
LEMMA_CUSTOM_OPENAI_API_KEY=
LEMMA_CUSTOM_OPENAI_MODELS=

# Account-plan routes use an existing official CLI login and never API-key fallback.
# Set an absolute executable when it is not discoverable on the installed service PATH.
LEMMA_CODEX_EXECUTABLE=
LEMMA_CLAUDE_EXECUTABLE=
LEMMA_GEMINI_EXECUTABLE=
LEMMA_SUBSCRIPTION_TIMEOUT_SECONDS=180

# Comma-separated model IDs explicitly verified to use only an on-device endpoint.
# A local_only project cannot use a real model unless it is listed here.
LEMMA_LOCAL_MODEL_IDS=

# Optional approval-gated headless coding. Keep disabled unless you have reviewed
# SECURITY.md, confirmed the CLI's billing mode, and set an absolute executable path.
LEMMA_ENABLE_HEADLESS_CODING=false
# LEMMA_HEADLESS_AGENT_EXECUTABLE=/absolute/path/to/claude
LEMMA_HEADLESS_AGENT_TIMEOUT_SECONDS=900

# The servers always bind to loopback. Keep these values unchanged.
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# New project workspaces are Git repositories under this directory.
# WORKSPACES_DIR=~/ai-company-workspaces
LOG_LEVEL=INFO
