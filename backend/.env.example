# ─────────────────────────────────────────────────────────────────────────────
# .env.example — a documented template for your local backend/.env
# READING ORDER: backend #2
#
# HOW TO USE: copy this file to `backend/.env` and fill in what you need.
#   cp backend/.env.example backend/.env
#
# The real `.env` is gitignored and loaded ONLY into the backend process
# (via python-dotenv) — never exported into your shell. That separation is a
# deliberate safety feature; see the billing warning below.
# ─────────────────────────────────────────────────────────────────────────────

# --- LLM provider keys ---------------------------------------------------------
# You need NONE of these to run in mock mode (the default). Add a DeepSeek key when
# you want the crew to use a real, cheap model.

DEEPSEEK_API_KEY=            # primary crew provider (cheapest). Get one at platform.deepseek.com
ANTHROPIC_API_KEY=           # optional — upgrade the PM / Explain roles if you have it
OPENAI_API_KEY=              # optional

# --- Mock mode -----------------------------------------------------------------
# true  = zero-cost, zero-key canned responses. GREAT for development. (default)
# false = call real models via LiteLLM (requires a matching key above).
MOCK_LLM=true
# Explicitly attest model IDs that resolve only to an on-device endpoint. Required
# before a `local_only` research project can run with MOCK_LLM=false.
LEMMA_LOCAL_MODEL_IDS=

# --- Host execution (secure default: off) ------------------------------------
# The R&D Studio's research agents never receive shell access. This separate flag
# unlocks only the trusted-human Workbench terminal, editor launch, and saved checks.
# Those processes run as your OS user and are NOT a container sandbox.
ENABLE_HOST_EXECUTION=false

# --- Optional headless coding (M9; secure default: off) ----------------------
# This is a separate, higher-risk surface from the human-operated terminal. A job
# runs only when BOTH switches are true, its durable plan has been approved in the
# Operations view, and the executable is an explicit absolute path. The adapter uses
# a fixed argv, a credential-stripped environment, a workspace-root check, and bounded
# time/output, but it is still a host process rather than a sandbox.
LEMMA_ENABLE_HEADLESS_CODING=false
LEMMA_HEADLESS_AGENT_EXECUTABLE=       # example: /absolute/path/to/claude
LEMMA_HEADLESS_AGENT_TIMEOUT_SECONDS=900

# --- Server binding ------------------------------------------------------------
# HOST is 127.0.0.1 (localhost) on purpose: this app spawns shells and runs commands
# inside your workspaces. Binding to 0.0.0.0 would expose that to your whole network.
# The server refuses to start on any other host. Remote access is not supported.
HOST=127.0.0.1
PORT=8000

# Exact browser origins trusted for mutations and WebSockets (comma separated).
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000,http://localhost:8000

# --- Where build workspaces are created ---------------------------------------
# Each approved Spec becomes a project directory under here. "~" expands to your home.
WORKSPACES_DIR=~/ai-company-workspaces

# --- Logging -------------------------------------------------------------------
# INFO by default; set to DEBUG to see the fine-grained internals.
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# ⚠️  BILLING WARNING — read once, remember forever
# ═══════════════════════════════════════════════════════════════════════════════
# Do NOT `export ANTHROPIC_API_KEY` (or OPENAI_API_KEY) in the shell where you run
# Claude Code or this app. If that variable is present, the `claude` CLI bills your
# API account PER TOKEN instead of using your subscription.
#
# This app keeps its keys here in .env (backend process only) and builds a minimal
# allowlisted environment for the embedded terminal and checks. Provider keys and
# other credential variables are never copied into child processes. See
# backend/app/shell_env.py.
#
# The optional headless Claude adapter also receives that sanitized environment. It
# may use subscription/session authentication already stored by the CLI under HOME;
# confirm the CLI's account and billing mode yourself before approving a job.
